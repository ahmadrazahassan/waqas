# ---- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS. Never prefix NEXT_PUBLIC_.
# Required for: referral attribution at signup, task approval payment,
# payouts, private JazzCash receipt submission, and payment verification.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Authenticates Vercel's daily commission-clearing request.
# Use a random value of at least 16 characters in every production environment.
CRON_SECRET=

# ---- Referral ---------------------------------------------------------------
# Salts the daily IP hash on referral clicks. Any long random string.
REFERRAL_HASH_SALT=

# Incoming payments use JazzCash QR and manual admin verification only.
# Apply supabase/migrations/202609090001_jazzcash_payment_review.sql first.
# Automated payment webhooks are disabled, regardless of old provider secrets.
