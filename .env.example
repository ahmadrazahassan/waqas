# ---- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS. Never prefix NEXT_PUBLIC_.
# Required for: referral attribution at signup, task approval payment,
# payouts, and confirming a bank transfer.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Referral ---------------------------------------------------------------
# Salts the daily IP hash on referral clicks. Any long random string.
REFERRAL_HASH_SALT=

# ---- Payment webhooks -------------------------------------------------------
# One secret per rail, named WEBHOOK_SECRET_<PROVIDER>. The route at
# /api/webhooks/<provider> returns 501 until the matching secret exists.
# WEBHOOK_SECRET_SAFEPAY=
# WEBHOOK_SECRET_PAYFAST=
