{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assignwork",
  "account_id": "880c6b851303fb3a3050f93368b565f4",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "minify": true,
  "keep_vars": true,
  "preview_urls": false,
  "triggers": { "crons": ["0 20 * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/images/payments/*"]
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "assignwork" }
  ],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
